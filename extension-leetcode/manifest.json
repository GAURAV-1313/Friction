{
  "manifest_version": 3,
  "name": "Recall for LeetCode",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "A tutor that anchors hints to the LeetCode problems you already solved.",
  "action": {
    "default_title": "Recall",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://anchor-production-1dea.up.railway.app/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["lc-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["config.js", "lc-queries.js", "lc-client.js", "lc-sync.js", "lc-content.js"],
      "run_at": "document_start"
    }
  ]
}
