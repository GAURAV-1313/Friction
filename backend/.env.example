PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=friction
DB_CONNECT_TIMEOUT_MS=30000
DB_KEEPALIVE_MS=10000
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM certificate content (single line with \n escapes)
DB_SSL_CA=

JWT_ISSUER=friction
JWT_AUDIENCE=friction-web
JWT_SECRET=change-me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
OAUTH_DEBUG=0

WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://nofriction.netlify.app

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_MS=60000
DEBUG_LLM=false
LLM_MAX_MOMENT_CHARS=5000
TOPIC_SIM_THRESHOLD=0.8
TOPIC_STOPWORDS=issue,problem,confusion,error,bug,mistake,case,edge,logic,understanding
SUBDOMAIN_SIM_THRESHOLD=0.82

# Hierarchical Snapshot (RAG)
HIERARCHICAL_SNAPSHOT=false
CLUSTER_SIM_THRESHOLD=0.7
RAG_TOP_K=5
RAG_SIM_THRESHOLD=0.65
RAG_SEARCH_SIM_THRESHOLD=0.55

# Adaptive Processing Thresholds
DIRECT_ANALYSIS_THRESHOLD=15
CLUSTER_THRESHOLD=50
VERY_LARGE_THRESHOLD=100

# Canonical Topics & Consolidation
CANONICAL_SIM_THRESHOLD=0.8
CONSOLIDATION_SIM_THRESHOLD=0.75
